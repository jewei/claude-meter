// The app version. scripts/release.sh rewrites both lines in the release commit.
//
// CURRENT_PROJECT_VERSION is CFBundleVersion, the number that Sparkle compares. It is the
// build of the newest release, or 400 before the first 4.x release. The next release must
// use a greater build; see "The build number" in docs/releasing.md. The last 3.x build is 337.

MARKETING_VERSION = 4.0.0
CURRENT_PROJECT_VERSION = 400
